# Copy to .env and fill in. run.sh loads it automatically.

# Supabase Postgres: Project Settings > Database > Connection string. Use the transaction pooler (port 6543) when deploying.
DATABASE_URL=postgresql://postgres.xxxxx:YOUR-PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Supabase Auth (Google, Microsoft, email): Project Settings > API
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_ANON_KEY=
# Only if your project still signs tokens with the legacy shared secret (Project Settings > API > JWT Secret)
SUPABASE_JWT_SECRET=

# Encrypts stored integration credentials. 32+ random characters. Losing it means reconnecting integrations.
GROUNDWORK_SECRET_KEY=

# Optional: Claude for grouping, specs, stories and Ask Velo
ANTHROPIC_API_KEY=

# Behind HTTPS (any real deployment)
GROUNDWORK_SECURE_COOKIES=0

# Optional: lets an external scheduler call POST /api/cron/run to sync trackers and import from discovery tools.
# 16+ random characters. Leave empty to keep the endpoint switched off.
GROUNDWORK_CRON_TOKEN=

# Optional: extra origins allowed to make browser writes (comma separated). The site's own origin is always allowed.
GROUNDWORK_ALLOWED_ORIGINS=
